    "format:check": "prettier --check .",
    "build": "echo \"No build step required (plain ESM JavaScript).\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.0.0"
  }
}
