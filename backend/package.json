{
  "name": "@lumbrecode/backend-template",
  "version": "0.1.0",
  "private": true,
  "description": "Optional Node.js backend base for LumbreCode Flutter apps",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
