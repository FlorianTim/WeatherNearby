{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumbrecode.de/schemas/knowledge/v1/frontmatter.schema.json",
  "title": "LumbreCode knowledge document frontmatter",
  "description": "YAML frontmatter of a Markdown document in the LumbreCode knowledge base. Existing fields (type, title, description, tags, status, generated, sources) keep their meaning; the others are added only where they apply. Lifecycle describes the thing documented, verification the strength of the evidence, status the document itself. Rules JSON Schema cannot express (ID prefix per type, implemented requires code evidence, relationship targets) are checked by tooling/knowledge/validate_knowledge.py.",
  "type": "object",
  "required": ["type", "title"],
  "properties": {
    "type": {
      "enum": [
        "application",
        "template",
        "capability",
        "implementation",
        "library",
        "standard",
        "known-issue",
        "reuse-candidate",
        "feature",
        "screenshot",
        "feature-catalog",
        "screenshot-index",
        "technical-overview",
        "reusable-solutions-report",
        "catalog",
        "feature-brief",
        "change-set",
        "reference"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+)*\\.[a-z0-9]+(?:[-.][a-z0-9]+)*$"
    },
    "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "app_id": { "type": "string", "pattern": "^app\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["draft", "review", "current", "outdated", "archived"] },
    "generated": { "type": "boolean" },
    "repository": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "app_version": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "enum": ["idea", "specified", "prototype", "implemented", "production", "deprecated"]
    },
    "verification": {
      "enum": ["reported", "documentation-reviewed", "code-verified", "test-verified", "release-verified"]
    },
    "last_verified": { "type": "string", "format": "date" },
    "platforms": {
      "type": "array",
      "items": { "enum": ["android", "ios", "web", "windows", "macos", "linux"] },
      "uniqueItems": true
    },
    "derived_from": { "type": "string", "pattern": "^template\\." },
    "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^cap\\." } },
    "implementations": { "type": "array", "items": { "type": "string", "pattern": "^impl\\." } },
    "related_documents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "screenshots": { "type": "array", "items": { "type": "string", "pattern": "^shot\\." } },
    "drive_file_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]{10,}$" },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": [
              "implements",
              "uses",
              "derived_from",
              "extends",
              "similar_to",
              "replaces",
              "blocked_by",
              "candidate_for_extraction"
            ]
          },
          "target": { "type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*\\.[a-z0-9]+(?:[-.][a-z0-9]+)*$" },
          "via": { "type": "string", "pattern": "^impl\\." },
          "evidence": { "type": "string" },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "kind": {
                "enum": ["code", "test", "manifest", "release", "doc", "spec", "screenshot", "knowledge"]
              },
              "ref": { "type": "string", "minLength": 1 },
              "revision": { "type": "string" },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": true
}
