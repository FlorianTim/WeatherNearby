<!-- GENERATED SOURCE - copied by scripts/bootstrap_android.* after
     `flutter create`. Edit the template under scripts/bootstrap/android-res/,
     not this copy: the next bootstrap overwrites it.

     Deliberately its own file and NOT values/colors.xml: flutter_launcher_icons
