# Central project configuration - sourced by bootstrap scripts.
# Adjust these values once when setting up a new project.
#
# LumbreCode convention:
#   ORG stays "de.lumbre.code" for all LumbreCode apps.
#   PROJECT_NAME is the app slug derived from the app specification (OpenSpec).
#   Resulting application id / package name: de.lumbre.code.<PROJECT_NAME>
#
# PROJECT_NAME must be a valid Android application id segment and Dart package
# name: lowercase letters, digits, underscores; must start with a letter.
#
# "todoapp" is the slug of the built-in Todo example app. Replace it only when
# initializing a real app from a concrete specification (see
# docs/operations/template-initialization.md).

ORG="de.lumbre.code"
PROJECT_NAME="todoapp"

# Web slug of the app — kebab-case, used for the public pages under
# https://lumbrecode.de/apps/<WEB_SLUG>/ and for the "[app:<WEB_SLUG>]" prefix
# on support mails. Separate from PROJECT_NAME because Android application id
# segments must not contain hyphens (e.g. "was-there-something" vs
# "wastheresomething"). Mirrored in apps/mobile_app/lib/app/app_identity.dart.
WEB_SLUG="todo-app"

# Dart package name of the Flutter app (pubspec `name` in apps/mobile_app,
# also the melos scope). The initializer sets this to the app slug when a
# new app is derived from the template.
APP_PACKAGE="mobile_app"

# Resulting Android/iOS application id — derived, do not set separately:
#   APPLICATION_ID = "$ORG.$PROJECT_NAME"

# VS Code workspace file in the repo root and dev container display name.
# The initializer renames the workspace file and devcontainer accordingly.
WORKSPACE_FILE="flutter_app_template.code-workspace"
DEVCONTAINER_NAME="Flutter App Template"

# scripts/dev/phone.sh (device backup/restore/pull-db). Only relevant when
# the app keeps its data in a folder under the Android shared storage root
# (/storage/emulated/0/<SHARED_STORAGE_DIR>); defaults shown.
# SHARED_STORAGE_DIR="<PROJECT_NAME>"      # folder name, default: PROJECT_NAME
DATABASE_FILE="app_database.sqlite"        # driftDatabase(name: ...) + ".sqlite"
# A snapshot or pre-release build names its file after its flavor, e.g.
# "app_database_snapshot.sqlite" (docs/operations/build-channels.md).
BACKUP_PATHS="db media"                    # paths inside the shared folder
