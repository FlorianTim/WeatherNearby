# Line endings: normalize in the repo, checkout per platform convention.
# This silences the CRLF warning flood from `flutter create` on Windows.
* text=auto

# Shell scripts must stay LF (bash on Windows/Git Bash breaks on CRLF).
*.sh   text eol=lf

# Windows script formats are CRLF by convention.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary formats — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.psd  binary
*.ai   binary
*.ipa  binary
*.aab  binary
*.apk  binary
*.jks  binary
*.keystore binary
*.ttf  binary
*.otf  binary
*.zip  binary
